storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: {{ mongodb_port }}
  bindIp: 127.0.0.1,{{ mongodb_private_ip }}

security:
  authorization: enabled

processManagement:
  timeZoneInfo: /usr/share/zoneinfo
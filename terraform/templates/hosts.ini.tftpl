# Generated by Terraform. Do not edit manually.

[web]
web-server ansible_host=${web_public_ip} private_ip=${web_private_ip}

[db]
db-server ansible_host=${db_private_ip} private_ip=${db_private_ip}

[db:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -i ${private_key_path} -o StrictHostKeyChecking=accept-new -W %h:%p ubuntu@${web_public_ip}"'

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${private_key_path}
ansible_python_interpreter=/usr/bin/python3
admin_ssh_cidr=${ssh_allowed_cidr}
vpc_cidr=${vpc_cidr}